rules_version = '2';

// =====================================================================
// DOOSAN 360 — FIRESTORE SECURITY RULES
//
// Exactly two roles exist: admin and siteManager (users/{uid}.role).
// Admin has broad administrative authority; Site Manager is restricted
// to the projects/machines listed on their own user document
// (assignedProjectIds / assignedMachineIds) and to their own
// operational records. There is no public sign-up — every users/{uid}
// document is created either by an Admin, or exactly once, by the
// first-run bootstrap path (see `users` and `system/meta` below).
// Firebase Auth + Firestore only; no Cloud Functions required.
//
// `allow read` below intentionally covers both `get` and `list`: every
// condition here is expressed in terms of the document actually being
// read (resource.data / the path's document id) plus the caller's own
// profile, so Firestore can validate it per-document for list/query
// operations the same way it does for a single get.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ---------------------------------------------------
    function signedIn() { return request.auth != null; }
    function myUid() { return request.auth.uid; }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(myUid())).data;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(myUid()))
        && myProfile().role == 'admin' && myProfile().active == true;
    }
    function isSiteManager() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(myUid()))
        && myProfile().role == 'siteManager' && myProfile().active == true;
    }
    function assignedToProject(projectId) {
      return isSiteManager() && (projectId in myProfile().assignedProjectIds);
    }
    function assignedToMachine(machineId) {
      return isSiteManager() && (machineId in myProfile().assignedMachineIds);
    }
    // Restrict a write to only the given fields (plus bookkeeping),
    // used for the narrow carve-outs a Site Manager needs on the
    // machine document (e.g. flipping status during a repair) without
    // granting general machine-editing rights.
    function onlyChanged(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    // -----------------------------------------------------------------
    // system/meta — single doc gating first-run bootstrap of the very
    // first Administrator account. Readable by anyone, even signed out,
    // so the login screen can decide whether to show first-time setup;
    // it holds no sensitive data. Created exactly once; never updated
    // or deleted afterward.
    // -----------------------------------------------------------------
    match /system/meta {
      allow get: if true;
      allow list: if false;
      allow create: if !exists(/databases/$(database)/documents/system/meta)
                    && signedIn()
                    && request.resource.data.adminBootstrapped == true;
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------
    // users/{uid}
    // -----------------------------------------------------------------
    match /users/{uid} {
      allow read: if signedIn() && (myUid() == uid || isAdmin());
      // Two ways a user document may be created:
      //  1) Admin creates ANY other account (Admin or Site Manager) —
      //     how every account except the first comes to exist.
      //  2) First-run bootstrap: a brand-new auth user may create their
      //     OWN doc as 'admin', but only while system/meta does not
      //     exist yet (i.e. before any Admin has been bootstrapped).
      //     Creating system/meta in the same batch closes this path
      //     forever.
      allow create: if isAdmin()
                    || (signedIn() && myUid() == uid
                        && request.resource.data.role == 'admin'
                        && request.resource.data.active == true
                        && !exists(/databases/$(database)/documents/system/meta));
      allow update: if isAdmin();
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // projects/{id}
    // -----------------------------------------------------------------
    match /projects/{id} {
      allow read: if isAdmin() || assignedToProject(id);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // machines/{id}
    // Site Managers may only flip the narrow set of operational fields
    // that legitimately change while they work the machine (status
    // during a repair/resume, and the maintenance engine's maintState
    // bookkeeping when they complete a service event). Everything
    // administrative (rental rate, lifetimeHours, projectId,
    // operatingConditions, creation) is Admin-only.
    // -----------------------------------------------------------------
    match /machines/{id} {
      allow read: if isAdmin() || assignedToMachine(id);
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (assignedToMachine(id)
                        && onlyChanged(['status','maintState','updatedAt','updatedBy']));
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // dailyLogs/{id} — the operating-log state machine.
    // A Site Manager may only touch their own logs, and only before
    // submission (or after a rejection, which reopens the record to
    // them). Once submitted it is locked to them; once approved it is
    // immutable to everyone except through the Admin correction path
    // (still an Admin-only update here, applied by the app's
    // correctApprovedLog()).
    // -----------------------------------------------------------------
    match /dailyLogs/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.managerId == myUid());
      allow create: if isAdmin()
                    || (isSiteManager()
                        && request.resource.data.managerId == myUid()
                        && assignedToMachine(request.resource.data.machineId)
                        && request.resource.data.status == 'not_started'
                        && request.resource.data.hoursApplied == false);
      allow update: if isAdmin()
                    || (isSiteManager()
                        && resource.data.managerId == myUid()
                        && resource.data.status != 'submitted'
                        && resource.data.status != 'approved'
                        && request.resource.data.status != 'approved'
                        && request.resource.data.managerId == resource.data.managerId
                        && request.resource.data.machineId == resource.data.machineId);
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // maintenanceServiceEvents/{id}
    // -----------------------------------------------------------------
    match /maintenanceServiceEvents/{id} {
      allow read: if isAdmin() || assignedToMachine(resource.data.machineId);
      allow create: if isAdmin()
                    || (isSiteManager()
                        && assignedToMachine(request.resource.data.machineId)
                        && request.resource.data.startedBy == myUid()
                        && request.resource.data.status == 'in_progress');
      allow update: if isAdmin()
                    || (assignedToMachine(resource.data.machineId) && resource.data.status == 'in_progress');
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // correctionRequests/{id} — Admin-only audit trail of manual
    // hour-meter and approved-record corrections. Append-only.
    // -----------------------------------------------------------------
    match /correctionRequests/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.requestedBy == myUid();
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------
    // auditLogs/{id} — append-only trail written by both roles for
    // their own actions. Never editable or deletable; readable by
    // Admin only.
    // -----------------------------------------------------------------
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.actorId == myUid();
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
